FROM golang:1.25-alpine AS build

WORKDIR /src/api

COPY api/go.mod api/go.sum ./
RUN go mod download

COPY api/ ./

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/messeances-api ./cmd/api \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sync-ugc ./cmd/sync-ugc \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/sync-kinepolis ./cmd/sync-kinepolis

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 messeances \
    && adduser -S -D -H -u 10001 -G messeances messeances

COPY --from=build /out/messeances-api /out/sync-ugc /out/sync-kinepolis /usr/local/bin/

USER 10001:10001
EXPOSE 8080
CMD ["messeances-api"]
