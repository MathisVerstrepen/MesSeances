# Images published by .github/workflows/publish-images.yml
IMAGE_BASE=ghcr.io/your-owner/your-repository
IMAGE_TAG=0000000000000000000000000000000000000000
UMAMI_IMAGE=ghcr.io/umami-software/umami:3.3.1

POSTGRES_DB=movieflow
POSTGRES_USER=movieflow
POSTGRES_PASSWORD=replace-with-generated-hex
ADMIN_PASSWORD=replace-with-generated-hex
ADMIN_SESSION_SECRET=replace-with-independent-generated-hex
TMDB_API_READ_ACCESS_TOKEN=
SYNC_REQUEST_TIMEOUT=20s
SYNC_KINEPOLIS_REQUEST_INTERVAL=2s
SYNC_OPERATION_TIMEOUT=2m

# Generate each required Umami secret independently. Keep the database password
# URL-safe because Compose interpolates it into DATABASE_URL.
UMAMI_POSTGRES_DB=umami
UMAMI_POSTGRES_USER=umami
UMAMI_POSTGRES_PASSWORD=replace-with-independent-generated-hex
UMAMI_APP_SECRET=replace-with-independent-generated-hex
UMAMI_TWO_FACTOR_ENCRYPTION_KEY=replace-with-independent-64-character-hex

# Absolute host path. Container UID 10001 must be able to read this file.
PROXY_FILE_HOST=/srv/messeances/secrets/proxies.txt

# Exact canonical public frontend origin and browser-visible API origin. Use
# http(s) origins without a trailing slash or path. Compose derives
# NUXT_PUBLIC_SITE_URL from WEB_ORIGIN and reaches the API internally at api:8080.
WEB_ORIGIN=https://cinema.example.com
NUXT_PUBLIC_API_BASE=https://cinema.example.com

# Browser-visible, not secrets. Leave either value empty until Umami bootstrap
# is complete. The script URL must be reachable by site visitors.
NUXT_PUBLIC_UMAMI_SCRIPT_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

API_PUBLISHED_PORT=8080
WEB_PUBLISHED_PORT=3000
UMAMI_PUBLISHED_PORT=3001
